BEGIN HEADER
   CharacterSet "CP1252"
   ExportingTool "Ascential DataStage Export"
   ToolVersion "4"
   ServerName "DSSERVER01"
   ToolInstanceID "DWPROJ"
   MDISVersion "1.0"
   Date "2005-06-20"
   Time "14.23.40"
   ServerVersion "7.5.1"
END HEADER
BEGIN DSJOB
   Identifier "PX_Extract_Accounts"
   DateModified "2005-06-14"
   TimeModified "08.30.12"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Readonly "0"
      Name "PX_Extract_Accounts"
      Description "Extracts the accounts of one region from the warehouse"
      NextID "2"
      Container "V0"
      JobVersion "56.0.0"
      ControlAfterSubr "0"
      Parameters "CParameters"
      BEGIN DSSUBRECORD
         Name "TargetDir"
         Prompt "Target directory"
         Default "/data/dw/out"
         ParamType "4"
         ParamLength "0"
         ParamScale "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "Region"
         Prompt "Region"
         Default "EU"
         ParamType "0"
         ParamLength "0"
         ParamScale "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "DB_USER"
         Prompt "Database user"
         Default "dwh_reader"
         ParamType "0"
         ParamLength "0"
         ParamScale "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "DB_PASSWORD"
         Prompt "Database password"
         Default "L7<;5:?M8>0"
         ParamType "1"
         ParamLength "0"
         ParamScale "0"
      END DSSUBRECORD
      JobType "3"
      Category "\\Jobs\\Accounts"
      CenturyBreakYear "30"
      AllowMultipleInvocations "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0"
      OLEType "CContainerView"
      Readonly "0"
      Name "Job"
      NextID "1"
      IsTopLevel "0"
      StageList "V0S0|V0S1"
      StageXPos "48|288"
      StageYPos "120|120"
      StageTypes "CCustomStage|CCustomStage"
      NextStageID "2"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0"
      OLEType "CCustomStage"
      Readonly "0"
      Name "SrcAccounts"
      NextID "2"
      OutputPins "V0S0P1"
      StageType "PxOracle"
      AllowColumnMapping "0"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "server"
         Value "DWHPROD"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "user"
         Value "#DB_USER#"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "password"
         Value "#DB_PASSWORD#"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0P1"
      OLEType "CCustomOutput"
      Readonly "0"
      Name "lnkAccounts"
      Partner "V0S1|V0S1P1"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "read_mode"
         Value "query"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "query"
         Value "SELECT ACCOUNT_ID, OWNER, STATUS FROM ACCOUNTS WHERE REGION = '#Region#' ORDER BY ACCOUNT_ID"
      END DSSUBRECORD
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "ACCOUNT_ID"
         SqlType "4"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "1"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "OWNER"
         SqlType "12"
         Precision "40"
         Scale "0"
         Nullable "1"
         KeyPosition "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "STATUS"
         SqlType "1"
         Precision "1"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CCustomStage"
      Readonly "0"
      Name "TgtAccounts"
      NextID "2"
      InputPins "V0S1P1"
      StageType "PxDataSet"
      AllowColumnMapping "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CCustomInput"
      Readonly "0"
      Name "lnkAccounts"
      Partner "V0S0|V0S0P1"
      Properties "CCustomProperty"
      BEGIN DSSUBRECORD
         Name "dataset"
         Value "#TargetDir#/accounts_#Region#.ds"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "updatePolicy"
         Value "overwrite"
      END DSSUBRECORD
   END DSRECORD
END DSJOB
