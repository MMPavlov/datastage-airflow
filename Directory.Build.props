<Project>
  <!--
    The whole solution is pinned to C# 8.0. The compiler rejects any newer
    syntax (records, init accessors, file-scoped namespaces, target-typed new,
    "is not" patterns, ...), so C# 8 compliance is enforced, not just intended.
  -->
  <PropertyGroup>
    <LangVersion>8.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Authors>ds2af</Authors>
    <Product>DataStage to Airflow migrator</Product>
    <Copyright>MIT License</Copyright>
  </PropertyGroup>
</Project>
