BEGIN DSJOB
   Identifier "SRV_Load_Orders"
   DateModified "2005-06-12"
   TimeModified "11.47.31"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Readonly "0"
      Name "SRV_Load_Orders"
      Description "Prices the day's orders with the product hashed file"
      NextID "4"
      Container "V0"
      JobVersion "56.0.0"
      ControlAfterSubr "0"
      Parameters "CParameters"
      BEGIN DSSUBRECORD
         Name "SourceDir"
         Prompt "Source directory"
         Default "/data/dw/in"
         ParamType "4"
         ParamLength "0"
         ParamScale "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "TargetDir"
         Prompt "Target directory"
         Default "/data/dw/out"
         ParamType "4"
         ParamLength "0"
         ParamScale "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "HashDir"
         Prompt "Hashed file directory"
         Default "/data/dw/hash"
         ParamType "4"
         ParamLength "0"
         ParamScale "0"
      END DSSUBRECORD
      Category "\\Jobs\\Orders"
      CenturyBreakYear "30"
      AllowMultipleInvocations "0"
      JobType "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0"
      OLEType "CContainerView"
      Readonly "0"
      Name "Job"
      NextID "1"
      IsTopLevel "0"
      StageList "V0S0|V0S1|V0S2|V0S3"
      StageXPos "48|240|240|432"
      StageYPos "120|24|120|120"
      StageTypes "CSeqFileStage|CHashedFileStage|CTransformerStage|CSeqFileStage"
      NextStageID "4"
      SnapToGrid "1"
      GridLines "0"
      ZoomValue "100"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0"
      OLEType "CSeqFileStage"
      Readonly "0"
      Name "SrcOrders"
      NextID "2"
      OutputPins "V0S0P1"
      UnixFormat "1"
      PipeStage "0"
      AllowColumnMapping "0"
      WithFilter "0"
      StageType "CSeqFileStage"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0P1"
      OLEType "CSeqOutput"
      Readonly "0"
      Name "lnkOrders"
      Partner "V0S2|V0S2P1"
      FileName "#SourceDir#/orders.txt"
      ColDelim ","
      QuoteChar "\""
      ColHeaders "0"
      FixedWidth "0"
      ColSpace "0"
      EnforceMetaData "0"
      Readtimeout "0"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "ORDER_ID"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "1"
         DisplaySize "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "ORDER_DATE"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "PRODUCT_ID"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "QTY"
         SqlType "4"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "CUSTOMER"
         SqlType "12"
         Precision "40"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
      Waitforwriter "0"
      PadChar "#"
      SuppressTruncWarn "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CHashedFileStage"
      Readonly "0"
      Name "hshProductsRef"
      NextID "2"
      OutputPins "V0S1P1"
      Directory "#HashDir#"
      StageType "CHashedFileStage"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CHashedOutput"
      Readonly "0"
      Name "lnkProductRef"
      Partner "V0S2|V0S2P2"
      FileName "HProducts"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "PRODUCT_ID"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "1"
         DisplaySize "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "DESCRIPTION"
         SqlType "12"
         Precision "40"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "PRICE"
         SqlType "3"
         Precision "8"
         Scale "2"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "CATEGORY"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CTransformerStage"
      Readonly "0"
      Name "xfmOrders"
      NextID "5"
      InputPins "V0S2P1|V0S2P2"
      OutputPins "V0S2P3|V0S2P4"
      ValidationStatus "0"
      StageType "CTransformerStage"
      BlockSize "0"
      StageVars "CStageVar"
      BEGIN DSSUBRECORD
         Name "svDate"
         Expression "Iconv(lnkOrders.ORDER_DATE, \"D/MDY[2,2,4]\")"
         InitialValue "0"
         SqlType "4"
         ParsedExpression "Iconv((lnkOrders.ORDER_DATE), (\"D/MDY[2,2,4]\"))"
         SourceColumn "lnkOrders.ORDER_DATE"
         Precision "10"
         ColScale "0"
         ExtendedPrecision "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "svAmount"
         Expression "lnkOrders.QTY * lnkProductRef.PRICE"
         InitialValue "0"
         SqlType "3"
         ParsedExpression "lnkOrders.QTY * lnkProductRef.PRICE"
         Precision "12"
         ColScale "2"
         ExtendedPrecision "0"
      END DSSUBRECORD
      StageVarsMinimised "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CTrxInput"
      Readonly "0"
      Name "lnkOrders"
      Partner "V0S0|V0S0P1"
      LinkType "1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P2"
      OLEType "CTrxInput"
      Readonly "0"
      Name "lnkProductRef"
      Partner "V0S1|V0S1P1"
      LinkType "2"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "PRODUCT_ID"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "1"
         DisplaySize "0"
         Derivation "Trim(lnkOrders.PRODUCT_ID)"
         ParsedDerivation "Trim((lnkOrders.PRODUCT_ID))"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "DESCRIPTION"
         SqlType "12"
         Precision "40"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "PRICE"
         SqlType "3"
         Precision "8"
         Scale "2"
         Nullable "0"
         KeyPosition "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "CATEGORY"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P3"
      OLEType "CTrxOutput"
      Readonly "0"
      Name "lnkOut"
      Partner "V0S3|V0S3P1"
      Constraint "Not(lnkProductRef.NOTFOUND)"
      Reject "0"
      ErrorPin "0"
      RowLimit "0"
      ParsedConstraint "Not((lnkProductRef.NOTFOUND))"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "ORDER_ID"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         Derivation "lnkOrders.ORDER_ID"
         SourceColumn "lnkOrders.ORDER_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "ORDER_DATE"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         Derivation "Oconv(svDate, \"D-YMD[4,2,2]\")"
         StageVars "svDate"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "PRODUCT"
         SqlType "12"
         Precision "40"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         Derivation "lnkProductRef.DESCRIPTION"
         SourceColumn "lnkProductRef.DESCRIPTION"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "AMOUNT"
         SqlType "3"
         Precision "12"
         Scale "2"
         Nullable "0"
         KeyPosition "0"
         Derivation "svAmount"
         StageVars "svAmount"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "CUSTOMER"
         SqlType "12"
         Precision "40"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         Derivation "Field(lnkOrders.CUSTOMER, \";\", 1)"
         SourceColumn "lnkOrders.CUSTOMER"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "INITIALS"
         SqlType "12"
         Precision "4"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         Derivation "lnkOrders.CUSTOMER[1,3] : \".\""
         SourceColumn "lnkOrders.CUSTOMER"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "TAG"
         SqlType "12"
         Precision "20"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         Derivation "FormatRunTag(\"ORD\", lnkOrders.ORDER_ID)"
         Transform "\(1B)FormatRunTag"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P4"
      OLEType "CTrxOutput"
      Readonly "0"
      Name "lnkMissing"
      Partner "V0S3|V0S3P2"
      Reject "1"
      ErrorPin "0"
      RowLimit "0"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "ORDER_ID"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         Derivation "lnkOrders.ORDER_ID"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "PRODUCT_ID"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         Derivation "lnkOrders.PRODUCT_ID"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3"
      OLEType "CSeqFileStage"
      Readonly "0"
      Name "TgtOrders"
      NextID "3"
      InputPins "V0S3P1|V0S3P2"
      UnixFormat "1"
      PipeStage "0"
      AllowColumnMapping "0"
      StageType "CSeqFileStage"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P1"
      OLEType "CSeqInput"
      Readonly "0"
      Name "lnkOut"
      Partner "V0S2|V0S2P3"
      FileName "#TargetDir#/orders_out.txt"
      Delimiter "|"
      QuoteChar "000"
      ColHeaders "1"
      OmitNewLine "0"
      Append "0"
      Backup "0"
      FixedWidth "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S3P2"
      OLEType "CSeqInput"
      Readonly "0"
      Name "lnkMissing"
      Partner "V0S2|V0S2P4"
      FileName "#TargetDir#/orders_missing.txt"
      Delimiter ","
      QuoteChar "000"
      ColHeaders "0"
      Append "0"
      FixedWidth "0"
   END DSRECORD
END DSJOB
