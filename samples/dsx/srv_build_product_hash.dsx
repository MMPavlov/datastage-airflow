BEGIN DSJOB
   Identifier "SRV_Build_Product_Hash"
   DateModified "2005-06-10"
   TimeModified "09.12.00"
   BEGIN DSRECORD
      Identifier "ROOT"
      OLEType "CJobDefn"
      Readonly "0"
      Name "SRV_Build_Product_Hash"
      Description "Loads the product hashed file used by the order load"
      NextID "3"
      Container "V0"
      JobVersion "56.0.0"
      ControlAfterSubr "0"
      Parameters "CParameters"
      BEGIN DSSUBRECORD
         Name "SourceDir"
         Prompt "Source directory"
         Default "/data/dw/in"
         ParamType "4"
         ParamLength "0"
         ParamScale "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "HashDir"
         Prompt "Hashed file directory"
         Default "/data/dw/hash"
         ParamType "4"
         ParamLength "0"
         ParamScale "0"
      END DSSUBRECORD
      Category "\\Jobs\\Orders"
      CenturyBreakYear "30"
      NextAliasID "2"
      ParameterFileDDName "DD00001"
      ReservedWordCheck "1"
      TransactionSize "0"
      ValidationStatus "0"
      AllowMultipleInvocations "0"
      JobType "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0"
      OLEType "CContainerView"
      Readonly "0"
      Name "Job"
      NextID "1"
      IsTopLevel "0"
      StageList "V0S0|V0S1|V0S2"
      StageXPos "48|240|432"
      StageYPos "120|120|120"
      StageTypes "CSeqFileStage|CTransformerStage|CHashedFileStage"
      NextStageID "3"
      SnapToGrid "1"
      GridLines "0"
      ZoomValue "100"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0"
      OLEType "CSeqFileStage"
      Readonly "0"
      Name "SrcProducts"
      NextID "2"
      OutputPins "V0S0P1"
      UnixFormat "1"
      PipeStage "0"
      UnicodeBOM "0"
      UnicodeSwapped "0"
      AllowColumnMapping "0"
      WithFilter "0"
      StageType "CSeqFileStage"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S0P1"
      OLEType "CSeqOutput"
      Readonly "0"
      Name "lnkProducts"
      Partner "V0S1|V0S1P1"
      FileName "#SourceDir#/products.txt"
      ColDelim "|"
      QuoteChar "000"
      ColHeaders "1"
      FixedWidth "0"
      ColSpace "0"
      EnforceMetaData "0"
      Readtimeout "0"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "PRODUCT_ID"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "DESCRIPTION"
         SqlType "12"
         Precision "40"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "PRICE"
         SqlType "3"
         Precision "8"
         Scale "2"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "CATEGORY"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
      END DSSUBRECORD
      Waitforwriter "0"
      PadChar "#"
      LeftTextPos "125"
      TopTextPos "112"
      SuppressTruncWarn "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1"
      OLEType "CTransformerStage"
      Readonly "0"
      Name "xfmProducts"
      NextID "3"
      InputPins "V0S1P1"
      OutputPins "V0S1P2"
      ValidationStatus "0"
      StageType "CTransformerStage"
      BlockSize "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P1"
      OLEType "CTrxInput"
      Readonly "0"
      Name "lnkProducts"
      Partner "V0S0|V0S0P1"
      LinkType "1"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S1P2"
      OLEType "CTrxOutput"
      Readonly "0"
      Name "lnkHash"
      Partner "V0S2|V0S2P1"
      Reject "0"
      ErrorPin "0"
      RowLimit "0"
      Columns "COutputColumn"
      BEGIN DSSUBRECORD
         Name "PRODUCT_ID"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "1"
         DisplaySize "0"
         Derivation "Trim(lnkProducts.PRODUCT_ID)"
         ParsedDerivation "Trim((lnkProducts.PRODUCT_ID))"
         SourceColumn "lnkProducts.PRODUCT_ID"
         Transform "\(1B)Trim"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "DESCRIPTION"
         SqlType "12"
         Precision "40"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
         Derivation "UpCase(lnkProducts.DESCRIPTION)"
         ParsedDerivation "UpCase((lnkProducts.DESCRIPTION))"
         SourceColumn "lnkProducts.DESCRIPTION"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "PRICE"
         SqlType "3"
         Precision "8"
         Scale "2"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
         Derivation "lnkProducts.PRICE"
         ParsedDerivation "lnkProducts.PRICE"
         SourceColumn "lnkProducts.PRICE"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "CATEGORY"
         SqlType "12"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "0"
         Derivation "If Trim(lnkProducts.CATEGORY) = \"\" Then \"MISC\" Else lnkProducts.CATEGORY"
         ParsedDerivation "If Trim((lnkProducts.CATEGORY)) = \"\" Then \"MISC\" Else lnkProducts.CATEGORY"
         SourceColumn "lnkProducts.CATEGORY"
      END DSSUBRECORD
      LeftTextPos "330"
      TopTextPos "112"
      LinkMinimised "0"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2"
      OLEType "CHashedFileStage"
      Readonly "0"
      Name "hshProducts"
      NextID "2"
      InputPins "V0S2P1"
      Directory "#HashDir#"
      StageType "CHashedFileStage"
   END DSRECORD
   BEGIN DSRECORD
      Identifier "V0S2P1"
      OLEType "CHashedInput"
      Readonly "0"
      Name "lnkHash"
      Partner "V0S1|V0S1P2"
      FileName "HProducts"
      ClearFile "1"
      BackupFile "0"
      CreateFile "1"
   END DSRECORD
END DSJOB
