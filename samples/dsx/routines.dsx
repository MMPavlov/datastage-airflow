BEGIN HEADER
   CharacterSet "CP1252"
   ExportingTool "Ascential DataStage Export"
   ToolVersion "4"
   ServerName "DSSERVER01"
   ToolInstanceID "DWPROJ"
   MDISVersion "1.0"
   Date "2005-06-20"
   Time "14.24.02"
   ServerVersion "7.5.1"
END HEADER
BEGIN DSROUTINES
   BEGIN DSRECORD
      Identifier "DWPROJ\\FormatRunTag"
      OLEType "CRoutine"
      Readonly "0"
      Name "FormatRunTag"
      Description "Run tag: prefix, underscore and the date without dashes"
      Category "\\Routines\\DWPROJ"
      RoutineType "1"
      Source =+=+=+=
* FormatRunTag(Prefix, RunDate)
Ans = Prefix : "_" : Convert("-", "", RunDate)
=+=+=+=
      Arguments "CArgument"
      BEGIN DSSUBRECORD
         Name "Prefix"
         Description "Tag prefix"
      END DSSUBRECORD
      BEGIN DSSUBRECORD
         Name "RunDate"
         Description "Date as yyyy-mm-dd"
      END DSSUBRECORD
   END DSRECORD
   BEGIN DSRECORD
      Identifier "DWPROJ\\CleanPhone"
      OLEType "CRoutine"
      Readonly "0"
      Name "CleanPhone"
      Description "Formats the digits of a phone number"
      Category "\\Routines\\DWPROJ"
      RoutineType "1"
      Source =+=+=+=
* CleanPhone(Phone)
Digits = Oconv(Phone, "MCN")
If Len(Digits) = 10 Then
   Ans = "(" : Digits[1,3] : ") " : Digits[4,3] : "-" : Digits[7,4]
End Else
   Ans = Digits
End
=+=+=+=
      Arguments "CArgument"
      BEGIN DSSUBRECORD
         Name "Phone"
      END DSSUBRECORD
   END DSRECORD
END DSROUTINES
